{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/../hooks/block-rm.sh\"" },
        { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/../hooks/guard.mjs"] }
      ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python3 ../hooks/prompt_filter.py" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/does-not-exist.sh" } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "definitely-not-a-real-binary-xyz --notify" } ] }
    ]
  }
}
