{
  "name": "hookfuzz",
  "version": "0.1.0",
  "description": "Test harness, spec runner and fuzzer for Claude Code hooks (any language). Build realistic payloads, assert decisions, fuzz edge cases, scan settings.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "hookfuzz": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "pretest": "npm run build && tsc -p tsconfig.test.json",
    "test": "node build-test/test/run.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "hooks",
    "testing",
    "fuzzing",
    "cli",
    "ai-agents"
  ],
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1"
  }
}
